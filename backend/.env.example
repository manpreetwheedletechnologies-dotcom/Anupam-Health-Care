# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string. IMPORTANT: Prisma requires MongoDB to run as
# a replica set (even a single-node one) — plain standalone mongod will
# fail on writes (create/update/delete) with a transactions error.
#   - MongoDB Atlas (even the free M0 tier) already runs as a replica set
#     — easiest option, just use its connection string below.
#   - Local mongod: start it with `mongod --replSet rs0`, then once, run
#     `mongosh --eval "rs.initiate()"` to initialize the replica set.
#
# Local example:
# DATABASE_URL="mongodb://127.0.0.1:27017/anupam?replicaSet=rs0"
# Atlas example:
# DATABASE_URL="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/anupam?retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://devclientg:SCpLNaejWusV7mcR@cluster0.vyinynw.mongodb.net/anupam?retryWrites=true&w=majority&appName=Cluster0"
# Where the frontend is running (for CORS)
FRONTEND_URL="http://localhost:3000"

PORT=4000

# Admin dashboard login — the actual login credential lives in the
# database (User collection), not here. These two values are only read
# ONCE when you run `npm run create-admin`, which hashes ADMIN_PASSWORD
# and stores it in MongoDB. After that, you can log in at /admin/login
# with this email + password. Re-run `npm run create-admin` any time to
# change the password (it upserts, so it's safe to re-run).
ADMIN_EMAIL="admin@anupamhealthcare.com"
ADMIN_PASSWORD="ChangeThisPassword123"

# Any long random string — used to sign admin login tokens
JWT_SECRET="change-this-to-a-long-random-string"
